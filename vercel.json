{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "json-string-array\\.vercel\\.app" }],
      "destination": "https://json-to-kv.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "json-string-array\\.vercel\\.app" }],
      "destination": "https://json-to-kv.vercel.app/:path*",
      "permanent": true
    }
  ]
}